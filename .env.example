# Ejemplo de archivo .env
# Copiar a .env y llenar con tus valores reales

# Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Claude API (para generador de ideas)
CLAUDE_API_KEY=tu_claude_api_key_aqui

# Google Drive (credenciales JSON)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Logging
LOG_LEVEL=INFO

# Base de datos
DATABASE_PATH=data/ajamsi.db
PREFERENCES_PATH=data/preferences.json

# Configuración de desarrollo
DEBUG=False
AMBIENTE=produccion
